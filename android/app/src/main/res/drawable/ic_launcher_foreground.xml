    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ظل الدرع السفلي (عمق) -->
    <path
        android:fillColor="#66001A33"
        android:pathData="M26,56.5 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z" />

    <!-- الدرع الرئيسي: تدرج أزرق صاعد -->
    <path android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="26"
                android:endX="82" android:endY="82">
                <item android:offset="0.0" android:color="#4C9CFF" />
                <item android:offset="0.55" android:color="#1F6FEB" />
                <item android:offset="1.0" android:color="#144A9E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- حافة علوية مضيئة (لمعان زجاجي) -->
    <path android:pathData="M32,45 a22,18 0 0,1 44,0 a26,22 0 0,1 -44,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="27"
                android:endX="54" android:endY="48">
                <item android:offset="0.0" android:color="#30FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

