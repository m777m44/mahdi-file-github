    <path
        android:pathData="M32.75,54 a21.25,21.25 0 1,0 42.5,0 a21.25,21.25 0 1,0 -42.5,0 Z"
        android:strokeColor="#26FFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />

    <!-- السهم: ظل ساقط (3D) -->
    <path
        android:fillColor="#33000000"
        android:pathData="M54,38 L67,53 H60.5 V65.5 H55.5 V53 H54 H52.5 V65.5 H47.5 V53 H41 Z M45.5,69.5 h17 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-17 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 Z" />

    <!-- السهم الرئيسي: تدرج أبيض فاخر -->
    <path android:pathData="M54,36 L67,51 H60.5 V63.5 H55.5 V51 H54 H52.5 V63.5 H47.5 V51 H41 Z M45.5,67.5 h17 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-17 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="41" android:startY="36"
                android:endX="67" android:endY="67">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#D8E3F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- لمسة خضراء صاعدة (GitHub Green) على رأس السهم -->
    <path android:pathData="M54,36 L67,51 H54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="36"
                android:endX="54" android:endY="51">
                <item android:offset="0.0" android:color="#3FB950" />
                <item android:offset="1.0" android:color="#238636" />
            </gradient>
        </aapt:attr>
