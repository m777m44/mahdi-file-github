<?xml version="1.0" encoding="utf-8"?>
<!-- شعار الأيقونة: درع دائري متدرج + سهم رفع ثلاثي الأبعاد بظل وعمق ولمعة -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
